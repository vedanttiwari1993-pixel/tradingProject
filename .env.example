# QuantNex local development defaults
APP_ENV=development
APP_NAME=QuantNex
APP_TIMEZONE=Asia/Kolkata

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database (local development only; replace credentials for private deployments)
DATABASE_URL=postgresql+psycopg://quantnex:quantnex_local_only@localhost:5432/quantnex

# Broker integration: only UPSTOX_SANDBOX is permitted in this phase.
TRADING_ENV=UPSTOX_SANDBOX
UPSTOX_SANDBOX_ACCESS_TOKEN=
# Set only after verifying the current official Sandbox host. Never use a production URL.
UPSTOX_SANDBOX_BASE_URL=

# OpenAI (optional; keep server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=
